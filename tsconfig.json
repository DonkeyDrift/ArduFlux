{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": [
      "ES2020"
    ],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "types": [
      "node",
      "vscode",
      "mocha",
      "chai"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/test/core/bspManager.test.ts",
    "src/test/uploader/compileBackend.test.ts",
    "src/test/uploader/wslCompile.test.ts",
    "src/test/uploader/wslExecutor.test.ts",
    "src/test/uploader/wslLibrarySync.test.ts",
    "src/test/uploader/wslPath.test.ts",
    "src/test/uploader/wslSync.test.ts"
  ]
}
