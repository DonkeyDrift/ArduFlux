{
  "name": "arduflux",
  "displayName": "ArduFlux",
  "description": "Manage embedded board, serial port, build output, monitor and profiles from VS Code.",
  "version": "0.4.3",
  "publisher": "DonkeyDrift",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/DonkeyDrift/ArduFlux.git"
  },
  "icon": "src/logo/ArduFlux-Logo-v1.5.png",
  "keywords": [
    "arduino",
    "embedded",
    "vscode-extension",
    "mcp",
    "model-context-protocol",
    "serial-port",
    "esp32"
  ],
  "engines": {
    "node": ">=18.0.0",
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "bin": {
    "arduflux-mcp": "bin/arduflux-mcp"
  },
  "contributes": {
    "activationEvents": [
      "onCommand:arduflux.openPanel",
      "onCommand:arduflux.validateConfig",
      "onCommand:arduflux.openConfigFile",
      "onCommand:arduflux.compileSketch",
      "onCommand:arduflux.uploadSketch",
      "onView:arduflux.editor"
    ],
    "commands": [
      {
        "command": "arduflux.openPanel",
        "title": "%arduflux.command.openPanel%"
      },
      {
        "command": "arduflux.validateConfig",
        "title": "%arduflux.command.validateConfig%"
      },
      {
        "command": "arduflux.openConfigFile",
        "title": "%arduflux.command.openConfigFile%"
      },
      {
        "command": "arduflux.compileSketch",
        "title": "%arduflux.command.compileSketch%"
      },
      {
        "command": "arduflux.uploadSketch",
        "title": "%arduflux.command.uploadSketch%"
      },
      {
        "command": "arduflux.refreshSidebar",
        "title": "%arduflux.command.refreshSidebar%",
        "icon": "$(refresh)"
      },
      {
        "command": "arduflux.runUploadScript",
        "title": "%arduflux.command.runUploadScript%"
      },
      {
        "command": "arduflux.compileOnly",
        "title": "%arduflux.command.compileOnly%"
      },
      {
        "command": "arduflux.uploadOnly",
        "title": "%arduflux.command.uploadOnly%"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "arduflux",
          "title": "ArduFlux",
          "icon": "$(circuit-board)"
        }
      ]
    },
    "views": {
      "arduflux": [
        {
          "id": "arduflux.editor",
          "type": "webview",
          "name": "%arduflux.view.editor%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "arduflux.refreshSidebar",
          "when": "view == arduflux.editor",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "arduflux.openPanel",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorTextFocus"
      },
      {
        "command": "arduflux.validateConfig",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus"
      },
      {
        "command": "arduflux.compileSketch",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "editorTextFocus"
      },
      {
        "command": "arduflux.uploadSketch",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u",
        "when": "editorTextFocus"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "DonkeyDrift.arduflux.mcp",
        "label": "ArduFlux MCP Server"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "vscode:prepublish": "npm run compile",
    "prepublishOnly": "npm run compile && npm test",
    "package": "vsce package --allow-missing-repository",
    "test": "npm run compile && mocha \"dist/test/**/*.test.js\"",
    "test:watch": "tsc -w -p ./ & mocha --watch \"dist/test/**/*.test.js\"",
    "install:vsix": "powershell -ExecutionPolicy Bypass -File .\\install-vsix.ps1",
    "install:vsix:trae": "powershell -ExecutionPolicy Bypass -File .\\install-vsix.ps1 -Ide trae",
    "install:vsix:code": "powershell -ExecutionPolicy Bypass -File .\\install-vsix.ps1 -Ide code",
    "mcp:stdio": "node dist/mcpServer.js --stdio",
    "mcp:sse": "node dist/mcpServer.js --sse"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.9.2",
    "@types/sinon": "^21.0.1",
    "@types/vscode": "^1.90.0",
    "@vscode/l10n-dev": "^0.0.35",
    "@vscode/vsce": "^3.6.2",
    "chai": "^6.2.2",
    "mocha": "^11.7.5",
    "sinon": "^21.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@vscode/l10n": "^0.0.18",
    "zod": "^4.4.3"
  }
}
